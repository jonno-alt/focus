+			"get_invoice",
+			"create_invoice",
+			"update_invoice",
+			"email_invoice",
+			"list_bills",
+			"create_bill",
+			"update_bill",
+			"list_credit_notes",
+			"create_credit_note",
+			"allocate_credit_note",
+			"list_quotes",
+			"create_quote",
+			"list_purchase_orders",
+			"create_purchase_order",
+			"list_payments",
+			"create_payment",
+			"delete_payment",
+			"create_batch_payment",
+			"allocate_overpayment",
+			"allocate_prepayment",
+			"list_bank_transactions",
+			"create_bank_transaction",
+			"update_bank_transaction",
+			"list_bank_transfers",
+			"create_bank_transfer",
