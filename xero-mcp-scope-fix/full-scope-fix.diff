+	const { server, names, callbacks } = fakeServer();
+	const result = registerAllTools(
+		server,
+		() => stubClient(calls),
+		() => propsWithScopes(clientGrant),
+		async () => {},
+		{ clientGrant: () => clientGrant, upstream },
+	);
+	return { names, callbacks, result, calls };
